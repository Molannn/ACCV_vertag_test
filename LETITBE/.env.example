# Gemini. Read by: preprocess.py decompose
GEMINI_API_KEY=

# OpenAI. Read by: letitbe.py when the engine is a gpt-* model
OPENAI_API_KEY=

# Hugging Face. Read by: letitbe.py --backend hf and finetune.py when the base model is gated, such as gemma
HF_TOKEN=

# Ollama endpoint. Optional, defaults to http://localhost:11434/v1
OLLAMA_BASE=
